# Copy to .env.local and fill in. `npm run dev` syncs these into your Convex deployment's env.
# (`npm run setup` adds CONVEX_DEPLOYMENT / NEXT_PUBLIC_CONVEX_URL to .env.local for you.)

# Required for the AI agent — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional agent tuning
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=low
# AGENT_CONFIDENCE_THRESHOLD=0.7
# AGENT_DISABLED=true

# Optional: require this value in the x-webhook-secret header of POST /webhooks/incoming-message
# WEBHOOK_SECRET=
